# Copy this file to .env (or .env.local) and edit.

# Where the backend lives. Never hard-code this in components (API Contract, section 2).
VITE_API_BASE_URL=/api/v1

# Mock switch (API Contract, section 10):
#   true  -> every module uses the mock backend in src/mocks
#   false -> every module calls the real Express backend
#   list  -> only these modules stay mocked, the rest go real.
#            Modules: auth,labs,environments,projects,datasets,usage,faculty,admin
#            e.g. VITE_USE_MOCKS=projects,datasets,usage,faculty,admin
VITE_USE_MOCKS=true
# Real backend (npm start in the backend repo, listens on :5000):  VITE_USE_MOCKS=false

# Fake network delay for mocks, in milliseconds
VITE_MOCK_DELAY_MS=350
