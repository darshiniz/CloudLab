      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api/v1"
    },
    {
      "key": "email",
      "value": "darshini@gbs.edu"
    },
    {
      "key": "password",
      "value": "student123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "envId",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "datasetId",
      "value": ""
    },
    {
      "key": "studentId",
      "value": ""
    }
