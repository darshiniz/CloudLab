{
  "name": "cloudlab-backend",
  "version": "1.0.0",
  "description": "CloudLab backend: Node/Express API implementing API Contract v1.0",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
