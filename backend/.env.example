# Copy to .env (development) or /etc/cloudlab/api.env (production). Every value shown is the default unless marked REQUIRED.
NODE_ENV=development
PORT=5000                                   # the frontend's Vite proxy points at :5000
PUBLIC_BASE_URL=http://localhost:5000       # production: https://cloudlab.example.edu  (used in workspace links)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
TRUST_PROXY=false                            # true behind nginx

JWT_SECRET=                                  # REQUIRED in production, 32+ random characters:  openssl rand -hex 32
JWT_EXPIRES_IN_SEC=28800

# Database: sqlite for development, mysql for Cloud SQL
DB_CLIENT=sqlite
DB_FILE=data/cloudlab.sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cloudlab
DB_PASSWORD=
DB_NAME=cloudlab
DB_SSL=false                                 # true for Azure Database for MySQL (requires TLS)
DB_SOCKET=                                   # Cloud SQL Auth Proxy socket, e.g. /cloudsql/PROJECT:asia-south1:INSTANCE

# Storage: in production this folder is the Cloud Storage bucket mounted with gcsfuse
STORAGE_ROOT=data/storage
WORKER_STORAGE_ROOT=                         # same bucket path as seen on the workers (default: same as STORAGE_ROOT)
GCS_BUCKET_NAME=cloudlab-storage
STORAGE_TOTAL_GB=50
STORAGE_QUOTA_BYTES=5368709120
MAX_UPLOAD_BYTES=104857600
MAX_DATASET_BYTES=209715200

# Containers: mock (no Docker needed) or docker
DRIVER=mock
MOCK_STEP_DELAY_MS=700
MOCK_SERVE_WORKSPACE=true
WORKER_1_DOCKER_HOST=                        # production: ssh://cloudlab@10.0.0.3   (empty = local Docker)
WORKER_1_IP=127.0.0.1                        # worker internal IP; lab ports are published on it
WORKER_2_DOCKER_HOST=
WORKER_2_IP=127.0.0.1
HOST_PORT_MIN=20000
HOST_PORT_MAX=20999

# Limits and policy defaults
MAX_QUEUE_LENGTH=10
MAX_ACTIVE_ENVS_PER_STUDENT=3
LOGIN_RATE_PER_MIN=10
DEFAULT_AUTO_STOP_ENABLED=true
DEFAULT_INACTIVITY_MINUTES=30
DEFAULT_MAX_LABS_PER_WORKER=4

# Background jobs
JOBS_ENABLED=true
HEARTBEAT_COUNTS_AS_ACTIVITY=false           # BRD BR-11: an open tab alone is not activity
SCHEDULED_STOP_ENABLED=false                 # optional daily shutdown
SCHEDULED_STOP_TIME=16:55
SCHEDULED_STOP_UTC_OFFSET_MIN=330

# First-run accounts
SEED_ADMIN_EMAIL=admin@gbs.edu
SEED_ADMIN_PASSWORD=admin123              # CHANGE in production (the server refuses to start with the default)
SEED_DEMO_DATA=true                          # demo faculty/students + sample datasets (false in production)
SEED_DEMO_PASSWORD=                         # empty = frontend demo passwords (student123 / faculty123)
LOG_LEVEL=info

# Elasticity (autoscaler) - Azure: needs role "Virtual Machine Contributor" for the control VM's managed identity on the resource group
CLOUD_PROVIDER=none                          # azure | mock (development) | none
AZURE_RESOURCE_GROUP=cloudlab-rg
# AZURE_SUBSCRIPTION_ID=                     # empty = read from the VM's metadata
WORKER_1_VM_NAME=cloudlab-worker-1
WORKER_2_VM_NAME=cloudlab-worker-2
AUTOSCALE_ENABLED=false                      # initial value; the admin panel switch is stored in the database
SCALE_OUT_AFTER_SEC=60
SCALE_IN_IDLE_MIN=10
MIN_WORKERS=1
SCALE_COOLDOWN_SEC=120

# Self-registration (BRD FR-15): institute email only, admin approval, student cap, 10 requests/min per IP
REGISTRATION_ENABLED=true
REGISTRATION_EMAIL_DOMAIN=gbs.edu            # empty = any address
REGISTRATION_MAX_STUDENTS=15                 # active + pending students
REGISTRATION_RATE_PER_MIN=10

# What a student can hand in for one activity
MAX_SUBMISSION_BYTES=104857600
MAX_SUBMISSION_FILES=2000
